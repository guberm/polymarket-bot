{
  "_NOTES": [
    "Copy this file to polymarket_bot_config.json and fill in your credentials.",
    "Config priority: CLI arg > env var > this file > code default.",
    "All keys can also be set as uppercase env vars (e.g. ANTHROPIC_API_KEY).",
    "For paper trading, only anthropic_api_key + API hosts are required.",
    "For live trading, also add polymarket_private_key + funder_address + exchange addresses.",
    "Remove the _NOTES key before use (or leave it — it's ignored)."
  ],

  "____SECTION_REQUIRED____": "── Required credentials ──────────────────────────────────────────────",

  "gamma_api_host": "https://gamma-api.polymarket.com",
  "clob_host": "https://clob.polymarket.com",

  "____SECTION_NETWORK____": "── Network used only by this bot; VPN modes run isolated in WSL ─────",

  "network_mode": "direct",
  "vpn_config_path": "C:\\Users\\you\\vpn\\location.conf",
  "vpn_wsl_distro": "Ubuntu",
  "wireguard_private_key": "",
  "wireguard_public_key": "",
  "openvpn_username": "",
  "openvpn_password": "",
  "proxy_type": "http",
  "proxy_host": "proxy-host.example.com",
  "proxy_port": 8080,
  "proxy_username": "",
  "proxy_password": "",
  "proxy_bypass": "localhost,127.0.0.1",

  "____SECTION_MODE____": "── Trading mode ──────────────────────────────────────────────────────",

  "live_trading": false,
  "initial_bankroll": 100,

  "____SECTION_LIVE____": "── Live trading credentials (only needed when live_trading=true) ───────",

  "polymarket_private_key": "0x...",
  "polymarket_funder_address": "0x...",
  "polymarket_signature_type": 0,
  "exchange_address": "0xE111180000d2663C0091e4f400237545B87B996B",
  "neg_risk_exchange_address": "0xe2222d279d744050d28e00520010520000310F59",

  "____SECTION_AUTOCLAIM____": "── Auto-claim won positions on-chain (.NET only) ──────────────────────",

  "auto_claim": true,
  "ctf_address": "0x4D97DCd97eC945f40cF65F87097ACe5EA0476045",
  "usdc_address": "0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174",
  "polygon_rpc_url": "https://polygon-rpc.com",

  "____SECTION_SCAN____": "── Market scanning / filtering ───────────────────────────────────────",

  "scan_interval_minutes": 10,
  "markets_per_cycle": 20,
  "min_liquidity": 10000,
  "min_volume_24hr": 500,
  "min_time_to_resolution_hours": 48,
  "min_market_price": 0.10,
  "max_spread": 0.04,
  "max_quote_age_seconds": 15,
  "quote_failure_grace_cycles": 3,
  "stale_quote_haircut_pct": 0.25,
  "resolution_checks_per_cycle": 20,
  "resolution_retry_hours": 6,

  "____SECTION_KALSHI____": "── Optional Kalshi comparison (read-only, never affects trades) ───────",

  "kalshi_shadow_enabled": false,
  "kalshi_api_host": "https://api.elections.kalshi.com/trade-api/v2",
  "kalshi_markets_limit": 200,
  "kalshi_min_match_score": 0.55,
  "kalshi_llm_same_threshold": 0.90,

  "____SECTION_WALLET_FLOW____": "── Aggregate public wallet flow (read-only, never affects trades) ────",

  "wallet_flow_shadow_enabled": false,
  "wallet_flow_api_host": "https://data-api.polymarket.com",
  "wallet_flow_window_minutes": 60,
  "wallet_flow_trades_limit": 500,
  "wallet_flow_large_trade_usd": 1000,

  "____SECTION_AI_PROVIDER____": "── AI provider (pick one) ────────────────────────────────────────────",

  "ai_provider": "anthropic",
  "multi_provider": false,

  "anthropic_enabled": true,
  "anthropic_api_key": "sk-ant-...",
  "anthropic_api_host": "https://api.anthropic.com",
  "anthropic_model": "claude-sonnet-4-6",

  "openai_enabled": true,
  "openai_api_key": "",
  "openai_api_host": "https://api.openai.com",
  "openai_model": "gpt-4o",

  "gemini_enabled": true,
  "gemini_api_key": "",
  "gemini_api_host": "https://generativelanguage.googleapis.com",
  "gemini_model": "gemini-2.0-flash",

  "openrouter_enabled": true,
  "openrouter_api_key": "",
  "openrouter_api_host": "https://openrouter.ai",
  "openrouter_model": "",

  "azure_openai_enabled": true,
  "azure_openai_api_key": "",
  "azure_openai_endpoint": "",
  "azure_openai_deployment": "",
  "azure_openai_api_version": "2024-02-01",

  "____SECTION_ESTIMATION____": "── Ensemble estimation settings ──────────────────────────────────────",

  "ensemble_size": 3,
  "ensemble_temperature": 0.7,
  "max_estimate_tokens": 1024,
  "max_estimate_std": 0.10,
  "llm_cost_tracking_enabled": true,
  "max_cycle_api_cost_usd": 1.00,
  "max_daily_api_cost_usd": 10.00,
  "api_pricing": "anthropic=3/15,openai=5/15,gemini=0.10/0.40,openrouter=3/15,azure_openai=5/15",
  "calibration_weighting_enabled": false,
  "calibration_min_samples": 40,
  "calibration_shrinkage": 0.50,
  "calibration_max_provider_weight": 0.60,

  "____SECTION_SIZING____": "── Position sizing ───────────────────────────────────────────────────",

  "min_edge": 0.10,
  "kelly_fraction": 0.20,
  "min_trade_usd": 0.5,
  "entry_price_buffer": 0.02,
  "max_live_order_bankroll_pct": 0.25,
  "allow_unsafe_risk": false,

  "____SECTION_RISK____": "── Risk limits ───────────────────────────────────────────────────────",

  "max_position_pct": 0.15,
  "max_total_exposure_pct": 1.00,
  "max_category_exposure_pct": 0.80,
  "max_event_exposure_pct": 0.30,
  "daily_stop_loss_pct": 0.20,
  "max_drawdown_pct": 0.50,
  "max_concurrent_positions": 10,

  "____SECTION_EXITS____": "── Position exit rules ───────────────────────────────────────────────",

  "enable_position_review": true,
  "position_stop_loss_pct": 0.25,
  "take_profit_price": 0.95,
  "exit_edge_buffer": 0.05,
  "review_reestimate_threshold_pct": 0.10,
  "review_ensemble_size": 3,
  "stop_loss_requires_negative_edge": true,

  "____SECTION_EMAIL____": "── Email notifications ───────────────────────────────────────────────",

  "email_enabled": false,
  "email_smtp_host": "smtp.gmail.com",
  "email_smtp_port": 587,
  "email_security": "auto",
  "email_use_tls": true,
  "email_user": "yourbot@gmail.com",
  "email_password": "xxxx-xxxx-xxxx-xxxx",
  "email_to": "you@example.com",

  "____SECTION_DATA____": "── Data storage ──────────────────────────────────────────────────────",

  "data_dir": "../data"
}
